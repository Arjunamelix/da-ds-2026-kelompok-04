# Salin menjadi .env lalu sesuaikan. Jangan commit .env.

# --- PostgreSQL (dipakai docker-compose) ---
POSTGRES_USER=pangan
POSTGRES_PASSWORD=ganti_password_ini
POSTGRES_DB=harga_pangan

# --- Backend Go ---
# "dev" mengizinkan sumber DEV (data sintetis). Ganti ke "prod" saat memakai data asli.
APP_ENV=dev
BACKEND_PORT=8080
REFERENSI_PATH=/app/config/referensi.json
ML_URL=http://ml:8000
# Layanan scraper (pengambil data otomatis). Biarkan bawaan; ganti hanya untuk uji tanpa Docker.
SCRAPER_URL=http://scraper:8000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# --- Layanan ML ---
# Minimal jumlah hari data per deret agar dimodelkan (Project.md 6.3 menyebut "misalnya 90")
ML_MIN_HARI=120

# --- Scraper (pengambil data otomatis dari SIMPANG) ---

# 1 = menarik data saat menyala dan sesuai jadwal; 0 = hanya lewat tombol "Ambil data sekarang"
SCRAPER_AKTIF=1
# Jam tarikan harian (WIB), dipisah koma
SCRAPER_JADWAL=10:00,16:00
# Email tim untuk User-Agent (identitas jujur ke server SIMPANG). Isi di .env, jangan di sini.
SCRAPER_KONTAK=
# 1 = data baru juga ditulis ke data/raw/master_data_harian.csv.
# Cukup SATU laptop di tim yang memakai 1 (dan meng-commit master); laptop lain pakai 0 agar tidak konflik git.
SCRAPER_TULIS_MASTER=1

# --- Port di laptop ---
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000